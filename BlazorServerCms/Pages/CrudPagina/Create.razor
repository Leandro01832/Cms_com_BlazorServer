@page "/pagina/create"
@using Mscc.GenerativeAI
@using Mscc.GenerativeAI.Types
@using business.business.Book
@using business.business.Group

@inject RepositoryPagina repository
@inject NavigationManager Navigation


<div class="container mt-4">
    <h3>Novo Conteúdo</h3>

     

    <EditForm Model="@novoConteudo" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Url do youtube</label>
                <input type="url" value="@novoConteudo.Html" 
                @onchange="OnHtmlChanged" 
                class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Título da Página</label>
            <InputText @bind-Value="novoConteudo.Titulo" class="form-control" />
            <ValidationMessage For="@(() => novoConteudo.Titulo)" />
        </div>

        <div class="mb-3">
            <label class="form-label">História (Story)</label>
            <InputSelect @bind-Value="novoConteudo.StoryId" class="form-select">
                <option value="0">Selecione uma história...</option>
                @foreach (var story in listaStories)
                {
                    <option value="@story.Id">@story.Nome</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Livro (Opcional)</label>
            <InputSelect @bind-Value="novoConteudo.LivroId" class="form-select">
                <option value="NENHUM">Nenhum</option>
                @foreach (var livro in listaLivros)
                {
                    <option value="@livro.Id">@livro.url</option>
                }
            </InputSelect>
        </div>

        

       

     

        <button type="submit" class="btn btn-primary">Salvar Conteúdo</button>
        <button type="button" class="btn btn-secondary" @onclick="Voltar">Cancelar</button>
    </EditForm>
</div>

@code {
    private Pagina novoConteudo = new Pagina();
    private List<Story> listaStories = new();
    private List<Livro> listaLivros = new();

    private DemoContextFactory db = new DemoContextFactory();
    private ApplicationDbContext context;

    protected override async Task OnInitializedAsync()
    {
        context = db.CreateDbContext(null);

        // Carrega dados para os Dropdowns
        listaStories = await context.Story.ToListAsync();
        listaLivros = await context.Livro.ToListAsync();
    }

    private async Task HandleValidSubmit()
    {

        try 
        {
            // A classe Pagina já inicializa a Data como DateTime.Now no set do Html
            context.Pagina.Add(novoConteudo);            
            await context.SaveChangesAsync();

            // Navega para a listagem após o sucesso
            Navigation.NavigateTo("/crud/pagina/1");
        }
        catch (Exception ex)
        {
            // Lógica de tratamento de erro aqui
            Console.WriteLine(ex.Message);
        }
    }

    private void Voltar() => Navigation.NavigateTo("/crud/pagina/1");

    private async Task OnHtmlChanged(ChangeEventArgs e)
    {
        novoConteudo.Html = e.Value?.ToString();
        var url = ExtrairUrlIframe(novoConteudo.Html);
        var titulo = ExtrairTitleIframe(novoConteudo.Html);
        novoConteudo.Titulo = titulo ?? novoConteudo.Titulo;

         var prompt = $@"Você é um sistema inteligente de classificação de conteudo (CMS).
            Sua tarefa é analisar cada url e indicar qual o capítulo correspondente.
            - Capítulo 1: Story Natureza (Inclui meio ambiente, cosmos, astronomia, animais, plantas, ciências naturais).
            - Capítulo 2: Story Moda e Estilo (Inclui moda, beleza, estilo de vida, tendências).
            - Capítulo 3: Story Veiculos e Transporte (Inclui carros, motos, bicicletas, transporte público).
            - Capítulo 4: Story Materiais e Construção (Inclui construção civil, materiais de construção, arquitetura).
            - capítulo 5: Story Casa e Decoração (Inclui decoração, design de interiores, móveis, jardinagem, eletronicos, eletrodómesticos).
            - capitulo 6: Story Imóveis e Imobiliária (Inclui imóveis, mercado imobiliário, arquitetura residencial).
            - capítulo 7: Story Alimentos e Bebidas (Inclui culinária, gastronomia, bebidas, receitas).
            - capítulo 8: Story entretenimento e Cultura (Inclui filmes, música, teatro, literatura, Viagens, Turismo, Esportes).
            - capítulo 9: Story Cosméticos, Beleza e Cuidados Pessoais (Inclui cosméticos, cuidados com a pele, cabelo, maquiagem, perfumaria).
            - capítulo 10: Story Tecnologia e Inovação (Inclui tecnologia, gadgets, inovação, ciência aplicada).
            - capítulo 11: Story Info-produtos e Marketing Digital (Inclui marketing digital, infoprodutos, e-commerce, estratégias online).
            - capítulo 12: Story Saúde e Bem-estar (Inclui saúde, fitness, bem-estar, medicina).
            - capítulo 13: Story Colecionáveis e Hobbies (Inclui hobbies, colecionáveis, atividades recreativas).
            - capítulo 14: Story Artes e Artesanato (Inclui artes, artesanato, trabalhos manuais, DIY).
            - capítulo 15: Story Estudos e materiais educativos (Inclui educação, estudos, materiais didáticos).
            - capítulo 16: Story Segurança e Proteção (Inclui segurança, proteção, vigilância, prevenção).
            - capítulo 17: Story Blog e Vlog (Inclui blogs, vlogs, conteúdo online, influenciadores).
            - capítulo 18: Story Empresas e Negócios (Inclui negócios, empreendedorismo, gestão, finanças).
            - capítulo 19: Story Notícias e Atualidades (Inclui notícias, atualidades, jornalismo, mídia).
            - capítulo 20: Story Agronegócio e Agricultura (Inclui agricultura, agronegócio, produção rural, agroindústria).
            - capítulo 21: Story projetos e Engenharia (Inclui engenharia, projetos, construção, inovação tecnológica).
            - capítulo 22: Story Serviços e Profissões (Inclui serviços, profissões, carreiras, mercado de trabalho).
            Regras Estritas de Resposta:
            1. Analise a url e determine qual o capitulo.
            2. Responda APENAS com os capitulos exatos encontrados na lista acima.
            3. Se houver mais de um capitulo correspondente, separe-os estritamente por uma vírgula e um espaço (exemplo: capítulo 1, capítulo 2).
           
            4. Não adicione saudações, explicações, aspas, introduções ou pontuação.
            
            A url do vídeo é: {url}

            ";

             string apiKey = repository.buscarApiGemini();

            // Configura o modelo (o gemini-2.5-flash é excelente e gratuito)
            var googleAI = new GoogleAI(apiKey);
            var model = googleAI.GenerativeModel(Model.Gemini25Flash);

            // Envia o prompt de forma assíncrona
            var response = await model.GenerateContent(prompt);

            // O texto da resposta estará aqui:
            Console.WriteLine(response.Text);

            var arr = response.Text!
            .Replace(" ", "")
            .Replace("capítulo", "")
            .Split(',');



        if (!string.IsNullOrEmpty(novoConteudo.Html))
        {
           // if(listaStories.Count == 0)
           // listaStories = await context.Story!.ToListAsync();
            novoConteudo.StoryId = listaStories.First(s => s.Capitulo == long.Parse(arr[0])).Id;
        }
    }

    public string? ExtrairUrlIframe(string htmlIframe)
{
    if (string.IsNullOrWhiteSpace(htmlIframe)) return null;

    // Busca pelo padrão src="URL" ou src='URL'
    var match = Regex.Match(htmlIframe, @"src=[""'](?<url>[^""']+)[""']", RegexOptions.IgnoreCase);

    if (match.Success)
    {
        return match.Groups["url"].Value;
    }

    return htmlIframe; // Caso já seja uma URL simples
}
   
    public string? ExtrairTitleIframe(string htmlIframe)
{
    if (string.IsNullOrWhiteSpace(htmlIframe)) return null;

    // Procura por title="TEXTO" ou title='TEXTO'
    var match = Regex.Match(htmlIframe, @"title=[""'](?<titulo>[^""']+)[""']", RegexOptions.IgnoreCase);

    if (match.Success)
    {
        return match.Groups["titulo"].Value;
    }

    return null; // Se não encontrar o atributo title, retorna nulo em vez do HTML inteiro
}

}