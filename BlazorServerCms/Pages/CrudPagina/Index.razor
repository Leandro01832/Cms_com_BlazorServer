@page "/crud/pagina/{pagina:int}"

@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<UserModel> userManager
@inject IJSRuntime? js

@inject RepositoryPagina repositoryPagina

@inject NavigationManager navigation



@if (camadas == null)
{
    <p><em>Carregando...</em></p>
}
else if (camadas.Length == 0)
{
    <p><em>Não existem paginas cadastradas...</em></p>
}
else
{
    <div>
        <a class="btn btn-success" href="pagina/create">Nova pagina</a>
        <input type="checkbox" onchange="@marcar" value="@marcado" /> paginas com filtro
       <select @onchange="selecionar" >
             @foreach (var item in tipos)
                                    {
                                            <option value="@item.Name" >
                                                @Activator.CreateInstance(item).ToString()
                                            </option>
                                        
                                    }                       
        </select>
     
    <label>Lista:</label>
    <select @onchange="selecionarCapitulo">
                <option value="0">Selecione um Capítulo...</option>
                @foreach (var story in listaStories)
                {
                    <option value="@story.Id">@story.Nome</option>
                }
            </select>

    <label>Portal:</label>
    <select @onchange="selecionarPortal">
                <option value="0">Selecione o Portal...</option>
                @foreach (var p in portais)
                {
                    <option value="@p.Id">@p.Nome</option>
                }
    </select>
    <input type="number" onchange="@acessarPagina" min="1" />

    </div>
    <div class="legenda-portal" style="background-color: rgb(149, 148, 148);">
        <span>legenda</span>

        @if(FilterStyles != null)
        @foreach (var estilo in FilterStyles)
        {
            var filtro = lista.FirstOrDefault(f => f.Id == estilo.FiltroId);
            if (filtro != null)
            {
                <span style="@estilo.Style">
                    @filtro.Nome
                </span>
            }
        }
        
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Data de Criação</th>
                <th>Camada</th>
              
                    <th>
                        Edita || Deletar
                        </th>

            </tr>
        </thead>
        <tbody>
            @foreach (var pagina in selecao)
            {

                <tr>
                    <td>@pagina.Id</td>
                    <td>@pagina.Data</td>
                    <td>
                        @if(pagina.Filtro.Count > 0)
                        {
                            @pagina.Filtro.Last().Filtro.CamadaId
                        }
                        else
                        {
                            <em>Sem filtro</em>
                        }
                        
                    </td>
                    <td>
                        <a class="btn btn-primary" href="pagina/edit/@pagina.Id">Editar</a>
                        <a class="btn btn-danger" href="pagina/delete/@pagina.Id">Deletar</a>
                        @if(!marcado)
                        {                           
                                <select class="form-select" @onchange="e => adicionarFiltro(e, pagina)">
                                    <option value="">Adicionar filtro</option>
                                    @foreach(var grupo in grupos)
                                    {
                                        var grup = lista
                                        .FirstOrDefault(g => g.Id == grupo.Id);
                                        var med = grup.Camada.Numero / 2;
                                        if(med == 1) med = 2;
                                        if(grup != null)
                                        while (grup.Camada.Numero > med)                                        
                                            grup = lista
                                            .FirstOrDefault(g => g.Id == grup.FiltroId);

                                            var l = lista.Where(g => g.Camada.Numero == grup.Camada.Numero &&
                                             g.PortalId == grup.PortalId).ToList();

                                            var quant = l.Count;                                             

                                            if(FilterStyles.Count == 0)
                                             for (int i = 0; i < quant; i++)
                                             {
                                                int r = repositoryPagina.random.Next(256);
                                                int g = repositoryPagina.random.Next(256);
                                                int b = repositoryPagina.random.Next(256);

                                                // Monta a string no formato CSS
                                                string estiloCss = $"background-color: rgb({r}, {g}, {b});";

                                                var css = estiloCss;
                                                FilterStyles.Add(new FilterStyle
                                                {
                                                    FiltroId = l[i].Id,
                                                    Style = css
                                                });
                                             }
                                             

                                        if(grup != null && grupo.Camada.Numero > med &&
                                        FilterStyles.Count > 0)
                                            foreach (var filterStyle in FilterStyles)
                                            {
                                                
                                                if (filterStyle.FiltroId == grup.Id)
                                                {
                                                    <option value="@grupo.Id" style="@filterStyle.Style" >
                                                         @grupo.Nome
                                                    </option> 
                                                }
                                            }                                    
                                        

                                    }
                               
                                </select>
                        }
                   
                    </td>
                </tr>
            }
        </tbody>
    </table>

}
<div>
    <label>Lista:</label>
    <input type="number" onchange="@acessarPagina" min="1" />
    <a class="btn btn-success" href="pagina/create">Nova pagina</a>
</div>

@code {

    protected Content[] camadas { get; set; }
    private List<Content> paginas { get; set; } = new List<Content>();
    private List<Content> selecao { get; set; } = new List<Content>();

        private List<Story> listaStories = new();
    [Parameter] public int pagina { get; set; } = 1;
    private DemoContextFactory db = new DemoContextFactory();
    private ApplicationDbContext Context;
    private ClaimsPrincipal usuario = null;
    private UserModel user = null;
    private bool marcado = false;
    private bool UserContent = true;

    private Type typeSelecionado = null;
    
    List<SubFiltro> grupos = new List<SubFiltro>();
    List<SubFiltro> lista = new List<SubFiltro>();
    List<Portal> portais = new List<Portal>();

    private List<FilterStyle>? FilterStyles = new List<FilterStyle>();
    

        private List<Type> tipos = null;

        private long? storyId = 2;
        private long? portalId = 0;

    protected override async Task OnParametersSetAsync()
    {
        await CarregaCamadas(pagina);
       
    }

    protected override async Task OnInitializedAsync()
    {
        Context = db.CreateDbContext(null);
        await CarregaCamadas(pagina);

        var authState = await AuthenticationStateProvider
               .GetAuthenticationStateAsync();
        usuario = authState.User;

        var u = await userManager.GetUserAsync(usuario);
        user = await Context.Users
        .Include(u => u.Livro)
        .ThenInclude(u => u.Livro)
        .FirstAsync(us => us.Id == u.Id);

         camadas = await Context.Content!
               .Include(p => p.Filtro)!
               .ThenInclude(f => f.Filtro)
               .ThenInclude(f => f.Portal)
                .OrderBy(p => p.Data)
        .ToArrayAsync();

        lista = await Context.SubFiltro
        .Include(sf => sf.Camada)
        .Include(sf => sf.Portal)
        .Where(pai => pai.Portal.StoryId == storyId && pai.LivroId == 1)
        .ToListAsync();

        listaStories = await Context.Story.Skip(1).ToListAsync();

        portais = await Context.Portal
        .Include(p => p.Filtro)
        .ToListAsync();

        

        // 1. Pega o "Assembly" (o seu programa/projeto executável)
            var assembly = typeof(Content).Assembly;

            // 2. Filtra todos os tipos que são subclasses de Animal
            tipos = assembly.GetTypes()
               .Where(t => t.IsSubclassOf(typeof(Content)) &&
               t.Namespace == "business.business.conteudo" &&
                !t.IsAbstract).ToList();

                Type itemParaMover = typeof(Pagina);
                Type itemParaMover2 = typeof(Chave);
                Type itemParaMover3 = typeof(ChangeContent);

            // 1. Verifica se o item realmente existe na lista
            if (tipos.Contains(itemParaMover))
            {
                // 2. Remove o item de sua posição atual
                tipos.Remove(itemParaMover);
                tipos.Remove(itemParaMover2);
                tipos.Remove(itemParaMover3);
                
                // 3. Insere o item na primeira posição (índice 0)
                tipos.Insert(0, itemParaMover);
            }

    }

    async Task CarregaCamadas(int pag)
    {
        if(camadas == null) return;
        selecao.Clear();
        selecao.AddRange(paginas
                .OrderBy(p => p.Data)
               .Skip((pag - 1) * 10)
               .Take(10)
                .ToList());
    }

   

    private async void adicionarFiltro(ChangeEventArgs e, Content pagina)
    {
        if (!string.IsNullOrEmpty(e.Value!.ToString()))
        {
            var filtroId = long.Parse(e.Value.ToString());
            var filtro = await Context.SubFiltro
                .FirstOrDefaultAsync(f => f.Id == filtroId);

            if (filtro != null)
            { 
                while (filtro != null)
                {
                    var paginaFiltro = new FiltroContent
                    {
                        ContentId = pagina.Id,
                        FiltroId = filtro.Id
                    };
                    Context.Add(paginaFiltro);
                    await Context.SaveChangesAsync();

                    if(filtro.CamadaId==1) break;
                   
                    filtro = await Context.SubFiltro
                    .FirstOrDefaultAsync(f => f.Id == filtro.FiltroId);
                }
                filtro = await Context.SubFiltro
                .FirstOrDefaultAsync(f => f.Id == filtroId);
                await AtualizarSequenciaVersiculosAsync(filtro.PortalId);
            }
                await js!.InvokeAsync<object>("DarAlert",
                     $"Filtro adicionado com sucesso!!");
                    navigation.NavigateTo($"/crud/pagina/1");
        }
    }

            private async Task marcar(ChangeEventArgs e)
    {
        marcado = (bool)e.Value;
        paginas.Clear();
        if ((bool)e.Value)
        {
            paginas.AddRange(camadas
               .Where(p => p.Filtro.Count > 0 )              
                 .ToList());

                  navigation.NavigateTo($"/crud/pagina/1"); 
        }
        else
        {
            paginas.AddRange(camadas
               .Where(p => p.Filtro.Count == 0)               
                 .ToList());

                  navigation.NavigateTo($"/crud/pagina/1"); 
        }
    }

            private async Task selecionar(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value!.ToString()))
        {
            paginas.Clear();
            var tipoSelecionado = e.Value.ToString();
            var tipo = tipos.FirstOrDefault(t => t.Name == tipoSelecionado);
            typeSelecionado = tipo;

            if (tipo != null)
            {
                if(marcado)
                {
                    paginas.AddRange(camadas
                    .Where(p => p.Filtro.Count > 0 && p.GetType() == tipo)                   
                    .ToList());
                    navigation.NavigateTo($"/crud/pagina/1"); 
                }
                else
                {
                     paginas.AddRange(camadas
                    .Where(p => p.Filtro.Count == 0 && p.GetType() == tipo)                    
                    .ToList());
                    navigation.NavigateTo($"/crud/pagina/1"); 
                }
            }
        }
    }   

            private async Task selecionarCapitulo(ChangeEventArgs e)
            {
                if (!string.IsNullOrEmpty(e.Value!.ToString()) && e.Value!.ToString() != "0")
                {
                    storyId = long.Parse(e.Value.ToString());
                    paginas.Clear();
                    if(marcado)
                    {
                        paginas.AddRange(camadas
                        .Where(p => p.StoryId == storyId &&
                        p.Filtro.Count > 0 &&
                        p.GetType().Name == 
                        Activator.CreateInstance(typeSelecionado).GetType().Name)
                        .OrderBy(p => p.Data)                 
                        .ToList());
                        navigation.NavigateTo($"/crud/pagina/1"); 
                    }
                    else
                    {
                        paginas.AddRange(camadas
                        .Where(p => p.StoryId == storyId &&
                        p.Filtro.Count == 0 &&
                        p.GetType().Name == 
                        Activator.CreateInstance(typeSelecionado).GetType().Name)
                        .OrderBy(p => p.Data)                 
                        .ToList());
                        navigation.NavigateTo($"/crud/pagina/1"); 
                    }
                }
                else
                {
                    paginas = camadas.Take(10).ToList();
                    navigation.NavigateTo($"/crud/pagina/1"); 
                }
            }
   
        private async Task selecionarPortal(ChangeEventArgs e)
        {
                grupos.Clear();
                if(FilterStyles != null)
                FilterStyles.Clear();
                if (!string.IsNullOrEmpty(e.Value!.ToString()) && e.Value!.ToString() != "0")
                {
                    portalId = long.Parse(e.Value.ToString());
                    var gruposFinais = await Context.SubFiltro
                    .Where(pai => !Context.SubFiltro.Any(filho => filho.FiltroId == pai.Id)
                     && pai.PortalId == portalId && pai.LivroId == 1)
                    .ToListAsync();
                    

                    foreach (var grupo in gruposFinais)
                    {
                        var subFiltro = await Context.SubFiltro
                        .Include(sf => sf.Camada)
                            .FirstOrDefaultAsync(sf => sf.Id == grupo.FiltroId);

                        if (subFiltro != null)
                        {
                            grupos.Add(subFiltro);
                        }
                    }
                    StateHasChanged();
                    
                }
       
        }

    private void acessarPagina(ChangeEventArgs e)
    {

        if (!string.IsNullOrEmpty(e.Value!.ToString()) && e.Value!.ToString() != "0")
        
            navigation.NavigateTo($"/crud/pagina/{e.Value!.ToString()}");
        
        else
            navigation.NavigateTo($"/crud/pagina/1"); 
    }

    private async void Incluir(long Id)
    {
        var livro = await Context.Livro!.FirstAsync(l => l.Id == Id);

        if(user.Livro != null && user.Livro.FirstOrDefault(l => l.Livro.StandardChapter == livro.StandardChapter) == null)
        {
            user.IncluiLivro(livro);
            await Context.SaveChangesAsync();
            await js!.InvokeAsync<object>("DarAlert", $"Livro incluido com sucesso!!");
            await js!.InvokeAsync<object>("ExecutarReload", $"teste");
        }
        else
        {
            await js!.InvokeAsync<object>("DarAlert", $"Só poderá ser incluido apenas um livro para cada segmento ou capitulo");
        }
        
    }

    private async void Remover(long Id)
    {
        var obj = await Context.UserModelLivro!
        .FirstAsync(l => l.LivroId == Id && l.UserModelId == user.Id);

        Context.Remove(obj);
        await Context.SaveChangesAsync();
        await js!.InvokeAsync<object>("DarAlert", $"Livro removido com sucesso!!");
        await js!.InvokeAsync<object>("ExecutarReload", $"teste");
    }

    private bool verificarLivro(Livro livro)
    {
        var liv = user.Livro.FirstOrDefault(l => l.LivroId == livro.Id);

        if (liv != null) return true;
        else return false;
    }

    public async Task AtualizarSequenciaVersiculosAsync(long portalId)
    {
        string sql = $@"
        WITH ConteudosValidos AS (
        SELECT DISTINCT
        c.id AS content_id,
        MIN(f.CamadaId) AS menor_camada_id,
        MIN(f.FiltroId) AS menor_filtro_id
        FROM Filtro f
        INNER JOIN Content c ON c.id = f.CriterioId
        INNER JOIN FiltroContent fc ON fc.FiltroId = f.Id
        INNER JOIN Filtro f ON f.Id = f.Id
        WHERE c.Versiculo IS NOT NULL and f.PortalId={portalId}
        GROUP BY c.id
        ),
        SequenciaPerfeita AS (
            SELECT
                content_id,
                ROW_NUMBER() OVER (ORDER BY menor_filtro_id ASC) AS novo_versiculo
            FROM ConteudosValidos
        )
        UPDATE c
        SET c.Versiculo = s.novo_versiculo
        FROM Content c
        INNER JOIN SequenciaPerfeita s ON c.id = s.content_id;";
     // Executa o comando diretamente no banco através do DbContext
        await Context.Database.ExecuteSqlRawAsync(sql);
    }



    public class FilterStyle
    {
        public long FiltroId { get; set; }
        public string Style { get; set; }
    }
}
