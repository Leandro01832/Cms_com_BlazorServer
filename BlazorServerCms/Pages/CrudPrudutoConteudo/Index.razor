@page "/crud/produtoconteudo/{pagina:int}"
@page "/crud/produtoconteudo"
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Produtos</h3>
        <a class="btn btn-success" href="/produtoconteudo/create">Novo Produto</a>
    </div>

    @if (produtos == null)
    {
        <p><em>Carregando...</em></p>
    }
    else if (produtos.Count == 0)
    {
        <p>Não existem produtos cadastrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Story</th>
                        <th>Livro</th>
                        <th>URL</th>
                        <th>Data</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in produtos)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Titulo</td>
                            <td>@(item.Story?.Nome ?? "-")</td>
                            <td>@(item.Livro?.url ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Afilado))
                                {
                                    <a href="@item.Afilado" target="_blank" rel="noreferrer">Abrir</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>@(item.Data?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-primary" href="/produtoconteudo/edit/@item.Id">Editar</a>
                                <a class="btn btn-sm btn-danger ms-1" href="/produtoconteudo/delete/@item.Id">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav aria-label="Paginação de produtos">
            <ul class="pagination">
                <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" href="/crud/produtoconteudo/@(pagina - 1)">Anterior</a>
                </li>
                <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" href="/crud/produtoconteudo/@(pagina + 1)">Próxima</a>
                </li>
            </ul>
            <span>Página @pagina de @totalPaginas</span>
        </nav>
    }
</div>

@code {
    [Parameter] public int pagina { get; set; } = 1;

    private const int ItensPorPagina = 10;
    private List<ProductContent>? produtos;
    private int totalPaginas = 1;

    protected override async Task OnParametersSetAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var total = await context.ProductContent.CountAsync();
        totalPaginas = Math.Max(1, (int)Math.Ceiling(total / (double)ItensPorPagina));
        pagina = Math.Clamp(pagina, 1, totalPaginas);

        produtos = await context.ProductContent
            .AsNoTracking()
            .Include(item => item.Story)
            .Include(item => item.Livro)
            .OrderBy(item => item.Titulo)
            .ThenBy(item => item.Id)
            .Skip((pagina - 1) * ItensPorPagina)
            .Take(ItensPorPagina)
            .ToListAsync();
    }
}
