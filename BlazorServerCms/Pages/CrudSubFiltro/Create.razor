@page "/SubFiltro/create"
@inject NavigationManager navigation
@inject RepositoryPagina repositoryPagina
@inject AuthenticationStateProvider? AuthenticationStateProvider
@inject UserManager<UserModel> userManager
@attribute [Authorize(Roles = "Admin, Manager, Assinante")]

<EditForm Model="@exampleModel" OnSubmit="@HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!EscolherUsuario)
    {

        <p>
            <label>Livro:</label>
            <select @bind="exampleModel.LivroId">

                @if(usuario != null && usuario.Assinatura != null)
                @foreach (var item in usuario.Assinatura)
                {
                    if (primeiroLoop)
                    {
                        <option value="@item.Livro!.Id" id="option@(item.Livro.Id)" selected>@item.Livro.Nome</option>
                        primeiroLoop = false;
                    }
                    else
                    {
                        <option value="@item.Livro!.Id" id="option@(item.Livro.Id)">@item.Livro.Nome</option>

                    }
                }
            </select>
        </p>

    }
    else
    {
        <p><input type="text" placeholder="Digite o Usuario" @bind="username" /></p>
        <p><a onclick="@escolher">Escolher</a></p>
        <p>
            <label>Livro:</label>
            <select @bind="exampleModel.LivroId">

                @foreach (var item in usuario.Assinatura)
                {
                    if (primeiroLoop)
                    {
                        <option value="@item.Livro!.Id" id="option@(item.Livro.Id)" selected>@item.Livro.Nome</option>
                        primeiroLoop = false;
                    }
                    else
                    {
                        <option value="@item.Livro!.Id" id="option@(item.Livro.Id)">@item.Livro.Nome</option>

                    }
                }
            </select>
        </p>
    }

    <p>
        <label>Portal:</label>
        <select @bind="exampleModel.PortalId">
                <option value="" id="opt0">Selecione um Portal</option>
            @foreach (var item in Portal)
            {
                <option value="@item.Id" id="option@(item.Id)">@item.Nome</option>
            }
        </select>
    </p>

    <p>
        <label>Nome:</label>
        <InputText id="Nome" @bind-Value="exampleModel.Nome" />
    </p>
   
    <p>
        <label>Filtro:</label>
        <select  @onchange="selecionarFiltro">

            <option value="" id="option0">Selecione um Filtro</option>
                
            @foreach (var item in SubFiltro!.Where(sub => sub.LivroId == exampleModel.LivroId && sub.PortalId == exampleModel.PortalId))
            {
                <option value="@item.Id" id="option@(item.Id)">@item.Nome</option>
            }
        </select>
    </p>
    
    <p>
        <label>Camada:</label>
        <select @bind="exampleModel.CamadaId">
            @foreach (var item in Camada!.Where(sub => sub.LivroId == exampleModel.LivroId))
            {
                <option value="@item.Id" id="option@(item.Id)"> Camada @item.Numero</option>
            }
        </select>
    </p>

     <p>
        <label>Critério:</label>
        <select @bind="exampleModel.CriterioId">
            <option value="" id="option" selected > Sem Critério</option>
            @foreach (var item in Criterio!)
            {
                <option value="@item.Id" id="option@(item.Id)"> @item.Descricao</option>
            }
        </select>
    </p>    

    <button type="submit">Adicionar</button>
    <a href="#" onclick="@InserirGruposFinais" @onclick:preventDefault >Inserir Grupos Finais</a>
</EditForm>

@code {
    private SubFiltro exampleModel = new();

    private List<Story> lista = new List<Story>();
    public List<SubFiltro> SubFiltro = new List<SubFiltro>();
    public List<Portal> Portal = new List<Portal>();
    public List<Camada> Camada = new List<Camada>();
    public List<Criterio> Criterio = new List<Criterio>();
    private DemoContextFactory db = new DemoContextFactory();
    private ApplicationDbContext Context;

    private UserModel usuario;
    private string? username;
    private bool EscolherUsuario;
    private bool primeiroLoop = true;

    //private long? StoryId;

    protected override async Task OnInitializedAsync()
    {
        Context = db.CreateDbContext(null);


        SubFiltro = await Context.SubFiltro!.Where(sub => !sub.UltimaPasta).ToListAsync();

        Portal = await Context.Portal!.ToListAsync();

        //  lista = await Context.Story!.ToListAsync();
        //  StoryId = lista.FirstOrDefault()?.Id;

        Camada = await Context.Camada!.ToListAsync();
        exampleModel.CamadaId = Camada.First().Id;
        Criterio = await Context.Criterio!.Include(cr => cr.Filtro).ToListAsync();

        var authState = await AuthenticationStateProvider!
      .GetAuthenticationStateAsync();
        var user = authState.User;

        usuario = Context.Users
       .Include(u => u.Assinatura)
       .ThenInclude(u => u.Livro)
       .First(u => u.UserName == user.Identity!.Name);

        if (await userManager.IsInRoleAsync(usuario, "Admin") || await userManager.IsInRoleAsync(usuario, "Manager"))
            EscolherUsuario = true;
    }

    private async void HandleSubmit()
    {
        await Context.AddAsync(exampleModel);
        await Context.SaveChangesAsync();
        navigation.NavigateTo("crud/SubFiltro/1");
    }

    private void escolher()
    {
        usuario = Context.Users
       .Include(u => u.Assinatura)
       .ThenInclude(u => u.Livro)
       .First(u => u.UserName == username);
        exampleModel.LivroId = usuario.Assinatura.First().Livro!.Id;
        primeiroLoop = true;
    }

    private void selecionarFiltro(ChangeEventArgs e)
    {
        exampleModel.FiltroId = Convert.ToInt64(e.Value);
        var fil = Context.Filtro!
        .Include(f => f.Camada)
        .FirstOrDefault(f => f.Id == exampleModel.FiltroId);

        var cam = Context.Camada!.FirstOrDefault(c => c.Numero == fil!.Camada.Numero + 1);

        if (cam != null)
            exampleModel.CamadaId = cam.Id;
        else
            exampleModel.CamadaId = null;
    }

    private async void InserirGruposFinais()
    {
        var gruposFinais = await Context.SubFiltro
        .Where(pai => !Context.SubFiltro.Any(filho => filho.FiltroId == pai.Id)
         && pai.PortalId == exampleModel.PortalId && pai.LivroId == exampleModel.LivroId)
        .ToListAsync();

        if(exampleModel.PortalId != 0 && exampleModel.LivroId != null)       
        foreach(var item in gruposFinais)
        {
            if(!item.UltimaPasta)
            {
                var f = new SubFiltro
                {
                    FiltroId = item.Id,
                    Nome = "ultima pasta",
                    CriterioId = item.CriterioId,
                    LivroId = item.LivroId,
                    PortalId = item.PortalId,
                    UltimaPasta = true,
                    CamadaId = item.CamadaId + 1,
                    Embaralhar = item.Embaralhar,
                    TerminarContagem = item.TerminarContagem,
                    
                };
                await Context.SubFiltro.AddAsync(f);
            }            
        }            
            await Context.SaveChangesAsync(); 
    }

}
