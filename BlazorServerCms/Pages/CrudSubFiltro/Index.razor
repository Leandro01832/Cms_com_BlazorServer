@page "/crud/SubFiltro/{pagina:int}"
@inject RepositoryPagina repositoryPagina
@inject NavigationManager navigation
@attribute [Authorize(Roles = "Admin")]



@if (camadas == null)
{
<p><em>Carregando...</em></p>
}
else if (camadas.Length == 0)
{
    <p><input type="text" placeholder="Digite o Usuario" @bind="username" /></p>
        <p><a onclick="@escolher">Escolher</a></p>
            <div >
				<label class="form-label" for="story">Portal</label>
				<InputSelect id="story" @bind-Value="PortalId"  @onchange="selecionarPortal" > 
					<option value="0">Selecione um portal...</option>
					@foreach (var portal in portais)
					{
						<option value="@portal.Id">@portal.Nome</option>
					}
				</InputSelect>
			</div>
<p><em>Não existem camadas cadastradas...</em></p>
}
else
{
<p><input type="text" placeholder="Digite o Usuario" @bind="username" /></p>
        <p><a onclick="@escolher">Escolher</a></p> 
        <div >
				<label class="form-label" for="story">Portal</label>
				<InputSelect id="story" @bind-Value="PortalId"  @onchange="selecionarPortal" > 
					<option value="0">Selecione um portal...</option>
					@foreach (var portal in portais)
					{
						<option value="@portal.Id">@portal.Nome</option>
					}
				</InputSelect>
			</div>

   

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Camada</th>
            <th>Editar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var camada in camadas)
        {
            <tr>
                <td>@camada.Nome</td>

                <td>
                    @if (camada.Camada != null)
                    {
                        <span>@camada.Camada.Numero</span>
                            
                    }
                    </td>
                <td><a class="btn btn-primary" href="SubFiltro/edit/@camada.Id">Editar</a> </td>
            </tr>
        }
    </tbody>
</table>

}
<div>
    <label>Lista:</label>
    <input type="number" onchange="@acessarPagina" min="1" />
    <a class="btn btn-success" href="SubFiltro/create">Novo filtro</a>
</div>

@code {

    protected SubFiltro[] camadas { get; set; }
    [Parameter] public int pagina { get; set; } = 1;
    private DemoContextFactory db = new DemoContextFactory();
    private ApplicationDbContext Context;

    private List<Portal> portais = new List<Portal>();

    private string? nome = "";
    private long? LivroId = null;
    private long? PortalId = null;

    private string? username;

    private UserModel usuario;

    protected override async Task OnParametersSetAsync()
    {
        await CarregaCamadas(pagina);
    }

    protected override async Task OnInitializedAsync()
    {
        Context = db.CreateDbContext(null);        
        portais = await Context.Portal!.ToListAsync();
    }

    async Task CarregaCamadas(int pag)
    {
        camadas = await Context.SubFiltro!
        .Include(s => s.Camada)
        .OrderBy(p => p.Id)
         .Where(f => f.LivroId == LivroId &&
          !f.UltimaPasta &&
          f.PortalId == PortalId)
               .Skip((pag - 1) * 7)
               .Take(7)
        .ToArrayAsync();
    }

    private void acessarPagina(ChangeEventArgs e)
    {
        if (!string.IsNullOrEmpty(e.Value!.ToString()) && e.Value!.ToString() != "0")
            navigation.NavigateTo($"/crud/SubFiltro/{e.Value!.ToString()}");
        else
            navigation.NavigateTo($"/crud/SubFiltro/1");
    }



    private async void escolher()
    {
        usuario = Context.Users
       .Include(u => u.Assinatura)
       .ThenInclude(u => u.Livro)
       .First(u => u.UserName == username);
        LivroId = usuario.Assinatura.First().Livro!.Id;
        await CarregaCamadas(pagina);
        StateHasChanged();
    }

    private async void selecionarPortal(ChangeEventArgs e)
    {
        PortalId = long.Parse(e.Value!.ToString()!);
        await CarregaCamadas(pagina);
        StateHasChanged();

    }
}
